# ghost_net node configuration
# copy to .env and edit — every value is optional, defaults shown
# (except BOOTSTRAP_NODES, which defaults to none)

# --- node ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# where the node keeps its keypair and the transmissions it is holding
DATA_DIR=_void

# --- entanglement (peers) -----------------------------------------------
# comma-separated peer endpoints to dial at boot, e.g. ws://localhost:3000/peer
# the public node; empty this to run a node that stays alone
BOOTSTRAP_NODES=wss://ghost-net.fly.dev/peer
# the address other nodes can reach this one at (wss://your.host/peer).
# leave empty for a node that only dials out; it is then never advertised.
PUBLIC_URL=
MAX_PEERS=16
# learn new peer addresses from the peers you are connected to
PEER_EXCHANGE=true
# how many times a transmission may be relayed before it stops travelling
MAX_HOPS=6
HEARTBEAT_INTERVAL=5000

# --- transmissions ------------------------------------------------------
# seconds until a transmission has fully decayed into the void (10 days)
TRANSMISSION_LIFETIME=864000
MAX_TRANSMISSION_LENGTH=2000
MAX_STORED_TRANSMISSIONS=1000

# --- consciousness ------------------------------------------------------
# breath frequency of an idle node, in Hz
BASE_FREQUENCY=0.137
# seconds for activity energy to halve
ACTIVITY_HALF_LIFE=600
PULSE_INTERVAL=2000

# --- limits -------------------------------------------------------------
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=300
TRANSMIT_LIMIT_MAX=20
MAX_BROWSERS=200
# when set, posting through this node needs the key (reading stays open)
TRANSMIT_KEY=
# set to 1 (or a proxy hop count) when running behind a reverse proxy
TRUST_PROXY=
